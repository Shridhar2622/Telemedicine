PORT=5000
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/telemedicine
SECRET_KEY=your_jwt_secret_key_here
FRONTEND_URL=https://your-frontend.vercel.app

# ===================================================================
# EMAIL DELIVERY OPTIONS (CHOOSE ONE FOR PRODUCTION)
# ===================================================================

# OPTION 1: BREVO / SENDINBLUE (RECOMMENDED FOR RENDER PRODUCTION)
# 1. Sign up at https://brevo.com (Free: 300 emails/day)
# 2. Get API key from Settings -> SMTP & API -> API Keys
# 3. Add your Gmail/email as a verified sender (no custom domain needed)
# 4. Never blocked by Render because it sends via HTTPS (port 443)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your_email@gmail.com
EMAIL_FROM_NAME="Telemedicine App"

# OPTION 2: RESEND (MODERN DEVELOPER EMAIL API)
# 1. Sign up at https://resend.com (Free: 3,000 emails/month)
# 2. Add API key:
# RESEND_API_KEY=re_123456789
# RESEND_FROM_EMAIL=onboarding@resend.dev

# OPTION 3: NODEMAILER / GMAIL SMTP (FOR LOCAL DEVELOPMENT ONLY)
# Note: Render and other cloud hosts block raw outbound SMTP ports 465/587 by default.
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# ===================================================================
# OPTIONAL GOOGLE AUTH
# ===================================================================
ENABLE_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
